{
  "name": "umanit/saml-bundle",
  "description": "Saml connection",
  "type": "symfony-bundle",
  "keywords": [
    "saml",
    "saml2",
    "symfony",
    "sso"
  ],
  "homepage": "https://github.com/umanit/saml-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Thomas CILES",
      "email": "tciles@umanit.fr"
    },
    {
      "name": "Nicolas Glandon",
      "email": "nglandon@umanit.fr"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "litesaml/lightsaml": "^4.1",
    "php": "^8.1|^8.2",
    "psr/log": "^1 || ^2 || ^3",
    "symfony/framework-bundle": "^6|^7",
    "symfony/cache": "^6|^7",
    "symfony/config": "^6|^7",
    "symfony/console": "^6|^7",
    "symfony/dependency-injection": "^6|^7",
    "symfony/deprecation-contracts": "^3",
    "symfony/event-dispatcher-contracts": "^3",
    "symfony/http-client": "^6|^7",
    "symfony/http-foundation": "^6|^7",
    "symfony/http-kernel": "^6|^7",
    "symfony/process": "^6|^7",
    "symfony/routing": "^6|^7",
    "symfony/security-bundle": "^6|^7",
    "symfony/security-core": "^6|^7",
    "symfony/security-http": "^6|^7",
    "symfony/twig-bundle": "^6|^7",
    "symfony/doctrine-bridge": "^6.4",
    "doctrine/orm": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "Umanit\\SamlBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Unit\\": "tests/Unit/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.10",
    "phpstan/phpstan-symfony": "^1.3",
    "squizlabs/php_codesniffer": "^3.8",
    "symfony/dotenv": "^6.0|^7.0",
    "phpstan/phpstan-doctrine": "^1.3",
    "rector/rector": "^1.0"
  }
}
