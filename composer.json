{
  "name": "umanit/saml-bundle",
  "description": "Saml connection",
  "type": "symfony-bundle",
  "keywords": [
    "saml",
    "saml2",
    "symfony",
    "sso"
  ],
  "homepage": "https://github.com/umanit/saml-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Thomas CILES",
      "email": "tciles@umanit.fr"
    },
    {
      "name": "Nicolas GANDON",
      "email": "ngandon@umanit.fr"
    },
    {
      "name": "Vivien De Bona",
      "email": "vdebona@umanit.fr"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.4",
    "doctrine/orm": "^2.14|^3.1",
    "litesaml/lightsaml": "^4.2",
    "psr/log": "^1 || ^2 || ^3",
    "symfony/framework-bundle": "^7.4",
    "symfony/cache": "^7.4",
    "symfony/config": "^7.4",
    "symfony/console": "^7.4",
    "symfony/dependency-injection": "^7.4",
    "symfony/deprecation-contracts": "^3",
    "symfony/event-dispatcher-contracts": "^3",
    "symfony/http-client": "^7.4",
    "symfony/http-foundation": "^7.4",
    "symfony/http-kernel": "^7.4",
    "symfony/process": "^7.4",
    "symfony/routing": "^7.4",
    "symfony/security-bundle": "^7.4",
    "symfony/security-core": "^7.4",
    "symfony/security-http": "^7.4",
    "symfony/twig-bundle": "^7.4",
    "symfony/doctrine-bridge": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "Umanit\\SamlBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Unit\\": "tests/Unit/"
    }
  },
  "require-dev": {
    "symfony/dotenv": "^7.4",
    "umanit/dev-bundle": "^3.0",
    "rector/rector": "^2.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpro/grumphp": true
    }
  }
}
